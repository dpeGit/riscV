    <comp lib="5" loc="(260,60)" name="Text">
      <a name="text" val="All function outputs will be mux'd and output on one pin"/>
    </comp>
    <comp lib="5" loc="(280,165)" name="Text">
      <a name="text" val="All control signals will be derived from standard mips funct codes"/>
    </comp>
    <comp lib="5" loc="(415,125)" name="Text">
      <a name="text" val="This is fine because we only use Z for the equality test for beq which sets the same control as sub"/>
