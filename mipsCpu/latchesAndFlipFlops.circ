  <circuit name="ms_jk_flip_flop">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="ms_jk_flip_flop"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(130,220)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Clk"/>
    </comp>
    <comp lib="0" loc="(140,180)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="J"/>
    </comp>
    <comp lib="0" loc="(140,260)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="K"/>
    </comp>
    <comp lib="0" loc="(240,410)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="E"/>
    </comp>
    <comp lib="0" loc="(980,210)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Q"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(980,230)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="notQ"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="1" loc="(250,180)" name="NAND Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(250,260)" name="NAND Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(300,270)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(490,340)" name="NOT Gate"/>
    <comp lib="1" loc="(650,160)" name="NAND Gate"/>
    <comp lib="1" loc="(650,280)" name="NAND Gate"/>
    <comp lib="8" loc="(316,73)" name="Text">
      <a name="text" val="the second half updates the second latch"/>
    </comp>
    <comp lib="8" loc="(415,55)" name="Text">
      <a name="text" val="the first latch updates on one half of the clock signal and then holds"/>
    </comp>
    <comp lib="8" loc="(454,93)" name="Text">
      <a name="text" val="if you trace the wires you can see that neither latch is ever in an unstable state"/>
    </comp>
    <comp lib="8" loc="(465,35)" name="Text">
      <a name="text" val="we can use a master slave setup with two sr latches to resolve the race condition"/>
    </comp>
