  <circuit name="jk_flip_flop">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="jk_flip_flop"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(150,210)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="J"/>
    </comp>
    <comp lib="0" loc="(150,250)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="Clk"/>
    </comp>
    <comp lib="0" loc="(150,290)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="K"/>
    </comp>
    <comp lib="0" loc="(340,390)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="label" val="E"/>
    </comp>
    <comp lib="0" loc="(670,240)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="Q"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(670,260)" name="Pin">
      <a name="appearance" val="NewPins"/>
      <a name="facing" val="west"/>
      <a name="label" val="notQ"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="1" loc="(290,210)" name="NAND Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(290,290)" name="NAND Gate">
      <a name="inputs" val="3"/>
    </comp>
    <comp lib="1" loc="(400,260)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="8" loc="(223,482)" name="Text">
      <a name="text" val="It also does work as an enable pin"/>
    </comp>
    <comp lib="8" loc="(311,60)" name="Text">
      <a name="text" val="The reason is that the state of this flip flop is subject to a race condition"/>
    </comp>
    <comp lib="8" loc="(316,429)" name="Text">
      <a name="text" val="While not strictly part of the formal design for a JK flip flop"/>
    </comp>
    <comp lib="8" loc="(350,44)" name="Text">
      <a name="text" val="Not that this does not work in logism although it is simpliest layout for a jk flip flop"/>
    </comp>
    <comp lib="8" loc="(373,448)" name="Text">
      <a name="text" val="This is needed because logism doesnt allow to set output initial pin value"/>
    </comp>
    <comp lib="8" loc="(384,78)" name="Text">
      <a name="text" val="In the real world (or a simulator with proper gate delay) we can resolve the race condition "/>
    </comp>
    <comp lib="8" loc="(395,96)" name="Text">
      <a name="text" val="by deliberately making one path take longer allowing the circut to settting in to a stable state"/>
    </comp>
    <comp lib="8" loc="(460,466)" name="Text">
      <a name="text" val="So the simulation starts in error. Starting with this off allows the circut to initialize in a valid state"/>
    </comp>
    <comp loc="(640,240)" name="sr_nand_latch"/>
